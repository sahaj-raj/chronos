# ==============================================================================
# Chronicles — Environment Configuration Template (.env.example)
# Copy this file to .env and insert your real credentials.
# .env is ignored by Git and will NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 2. Server & Spring Profile Configuration
# - Use 'local' for local development (embedded H2 file database)
# - Use 'prod' for production (requires PostgreSQL via DATABASE_URL or PG* vars)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
PORT=8080

# ------------------------------------------------------------------------------
# 3. Production PostgreSQL Database Configuration (Railway / Supabase)
# Railway PostgreSQL plugin provides DATABASE_URL and PG* variables automatically.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:your_db_password@host:5432/railway
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_db_password
# PGDATABASE=railway

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Frontend URL)
# Provide your frontend URL (e.g. localhost for dev or Vercel URL in prod)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

